# --------------------------------------------------
# Multi-Agent Research Assistant — Environment Config
# --------------------------------------------------
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# OpenAI API Key (required for live mode, not needed for --demo)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model to use (default: gpt-4o-mini for cost efficiency)
OPENAI_MODEL=gpt-4o-mini

# Verbose output — see agent reasoning in real time
VERBOSE=true
